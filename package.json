{
  "name": "timehub-desktop",
  "productName": "TimeHub",
  "version": "1.2.1",
  "description": "TimeHub desktop (Electron wrapper for app.timehub.company) with native whole-computer idle, compliant consent-based screen monitoring, and auto-update.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "dist": "node scripts/build-win.js --publish never",
    "publish": "node scripts/build-win.js --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mindtechb2b.timehub",
    "productName": "TimeHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "startup-task.js",
      "node_modules/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asarUnpack": [
      "build/icon.ico",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jic52194",
        "repo": "timehub-desktop"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appx": {
      "identityName": "PLACEHOLDER.PartnerCenter.IdentityName",
      "publisher": "CN=PLACEHOLDER-PARTNER-CENTER-PUBLISHER",
      "publisherDisplayName": "PLACEHOLDER Publisher Display Name",
      "applicationId": "TimeHub",
      "displayName": "TimeHub",
      "backgroundColor": "#123454",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true,
      "customExtensionsPath": "build/appx-startup-task.xml",
      "electronUpdaterAware": false,
      "artifactName": "TimeHub-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TimeHub",
      "artifactName": "TimeHub-Setup.${ext}"
    }
  }
}
