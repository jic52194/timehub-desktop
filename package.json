{
  "name": "timehub-desktop",
  "productName": "TimeHub",
  "version": "1.3.2",
  "description": "TimeHub desktop (Electron wrapper for app.timehub.company) with native whole-computer idle, compliant consent-based screen monitoring, USB drive and file-copy logging, and auto-update.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --win --publish never",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mindtechb2b.timehub",
    "productName": "TimeHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "device-monitor.js",
      "node_modules/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asarUnpack": [
      "build/icon.ico",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jic52194",
        "repo": "timehub-desktop"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TimeHub",
      "include": "build/installer.nsh",
      "artifactName": "TimeHub-Setup.${ext}"
    }
  }
}
